pragma solidity ^0.8.20;

interface IEnergyToken {
    function mint(address to, uint256 amount) external returns (bool);
    function transfer(address to, uint256 amount) external returns (bool);
    function transferFrom(address from, address to, uint256 amount) external returns (bool);
    function balanceOf(address account) external view returns (uint256);
}

/**
 * @title EnergyMarketplace
 * @dev Peer-to-peer microgrid energy trading protocol for SolGrid.
 * Enables prosumers to mint verified solar energy tokens and trade kilowatt-hours
 * peer-to-peer with automated escrow and instant settlements.
 */
contract EnergyMarketplace {
    // --- State Variables ---
    IEnergyToken public immutable energyToken;
    address public owner;
    uint256 public nextListingId = 1;
    uint256 public totalEnergyTraded; // In token wei
    uint256 public totalEtherVolume;  // In wei
    uint256 public totalEnergyMinted;  // In token wei

    // Nonce for reentrancy guard
    uint8 private _unlocked = 1;

    struct Listing {
        uint256 id;
        address payable seller;
        uint256 energyAmount; // NRG token amount (in 18 decimals)
        uint256 pricePerKwh;  // Price in Wei per 1 full NRG token (1 kWh)
        uint256 totalPrice;   // Total price in Wei
        bool active;
        uint256 createdAt;
    }

    mapping(uint256 => Listing) public listings;
    mapping(address => bool) public authorizedMeters;

    // --- Events ---
    event EnergyMinted(
        address indexed prosumer,
        uint256 kwhAmount,
        uint256 timestamp
    );

    event EnergyListed(
        uint256 indexed listingId,
        address indexed seller,
        uint256 energyAmount,
        uint256 pricePerKwh,
        uint256 timestamp
    );

    event EnergyPurchased(
        uint256 indexed listingId,
        address indexed buyer,
        address indexed seller,
        uint256 energyAmount,
        uint256 totalPrice,
        uint256 timestamp
    );

    event ListingCancelled(
        uint256 indexed listingId,
        address indexed seller,
        uint256 energyAmount,
        uint256 timestamp
    );

    event MeterAuthorized(address indexed meter, bool isAuthorized);

    modifier nonReentrant() {
        require(_unlocked == 1, "EnergyMarketplace: REENTRANCY_GUARD");
        _unlocked = 0;
        _;
        _unlocked = 1;
    }

    modifier onlyOwner() {
        require(msg.sender == owner, "EnergyMarketplace: caller is not the owner");
        _;
    }

    modifier onlyAuthorizedMeter() {
        require(
            authorizedMeters[msg.sender] || msg.sender == owner,
            "EnergyMarketplace: unauthorized IoT meter oracle"
        );
        _;
    }

    constructor(address _energyTokenAddress) {
        require(_energyTokenAddress != address(0), "EnergyMarketplace: invalid token address");
        energyToken = IEnergyToken(_energyTokenAddress);
        owner = msg.sender;
        authorizedMeters[msg.sender] = true;
    }

    /**
     * @notice Authorize or revoke an IoT smart meter oracle address.
     */
    function setMeterAuthorization(address _meter, bool _isAuthorized) external onlyOwner {
        require(_meter != address(0), "EnergyMarketplace: zero address");
        authorizedMeters[_meter] = _isAuthorized;
        emit MeterAuthorized(_meter, _isAuthorized);
    }

    /**
     * @notice Records verified solar energy generated by a microgrid prosumer and mints NRG tokens.
     * @param prosumer The address of the prosumer with rooftop solar generation
     * @param kwhAmount Amount of energy generated in standard token units (18 decimals, where 1e18 = 1 kWh)
     */
    function recordSolarGeneration(address prosumer, uint256 kwhAmount) external onlyAuthorizedMeter {
        require(prosumer != address(0), "EnergyMarketplace: invalid prosumer address");
        require(kwhAmount > 0, "EnergyMarketplace: kWh amount must be greater than zero");

        totalEnergyMinted += kwhAmount;
        bool minted = energyToken.mint(prosumer, kwhAmount);
        require(minted, "EnergyMarketplace: token mint failed");

        emit EnergyMinted(prosumer, kwhAmount, block.timestamp);
    }

    /**
     * @notice Prosumers lock NRG tokens into marketplace escrow and create an active order.
     * @param energyAmount Amount of NRG tokens to sell (in 18 decimals)
     * @param pricePerKwh Price in wei per 1 kWh (1e18 NRG)
     */
    function listEnergy(uint256 energyAmount, uint256 pricePerKwh) external nonReentrant returns (uint256) {
        require(energyAmount > 0, "EnergyMarketplace: energyAmount must be > 0");
        require(pricePerKwh > 0, "EnergyMarketplace: pricePerKwh must be > 0");

        // Calculate total price: (energyAmount * pricePerKwh) / 1e18
        uint256 totalPrice = (energyAmount * pricePerKwh) / 1e18;
        require(totalPrice > 0, "EnergyMarketplace: total price underflow");

        // Escrow transfer NRG tokens from seller to this marketplace
        bool transferred = energyToken.transferFrom(msg.sender, address(this), energyAmount);
        require(transferred, "EnergyMarketplace: token escrow transfer failed");

        uint256 listingId = nextListingId++;
        listings[listingId] = Listing({
            id: listingId,
            seller: payable(msg.sender),
            energyAmount: energyAmount,
            pricePerKwh: pricePerKwh,
            totalPrice: totalPrice,
            active: true,
            createdAt: block.timestamp
        });

        emit EnergyListed(listingId, msg.sender, energyAmount, pricePerKwh, block.timestamp);
        return listingId;
    }

    /**
     * @notice Buyer pays native test ETH/MATIC to purchase NRG tokens from an active order.
     * The escrow automatically releases native currency to the seller and transfers NRG tokens to the buyer.
     * @param listingId Identifier of the order to buy
     */
    function buyEnergy(uint256 listingId) external payable nonReentrant {
        Listing storage listing = listings[listingId];
        require(listing.active, "EnergyMarketplace: listing is not active");
        require(msg.value >= listing.totalPrice, "EnergyMarketplace: insufficient ETH sent");
        require(msg.sender != listing.seller, "EnergyMarketplace: seller cannot buy own listing");

        listing.active = false;
        totalEnergyTraded += listing.energyAmount;
        totalEtherVolume += listing.totalPrice;

        // Escrow transfer: Send native ETH to seller
        (bool sentEth, ) = listing.seller.call{value: listing.totalPrice}("");
        require(sentEth, "EnergyMarketplace: ETH payment to seller failed");

        // Escrow transfer: Send NRG tokens to buyer
        bool transferred = energyToken.transfer(msg.sender, listing.energyAmount);
        require(transferred, "EnergyMarketplace: NRG transfer to buyer failed");

        // Refund any excess ETH sent by buyer
        if (msg.value > listing.totalPrice) {
            uint256 refund = msg.value - listing.totalPrice;
            (bool refunded, ) = payable(msg.sender).call{value: refund}("");
            require(refunded, "EnergyMarketplace: ETH refund failed");
        }

        emit EnergyPurchased(
            listingId,
            msg.sender,
            listing.seller,
            listing.energyAmount,
            listing.totalPrice,
            block.timestamp
        );
    }

    /**
     * @notice Cancel an active listing and withdraw escrowed NRG tokens.
     */
    function cancelListing(uint256 listingId) external nonReentrant {
        Listing storage listing = listings[listingId];
        require(listing.active, "EnergyMarketplace: listing is not active");
        require(listing.seller == msg.sender || msg.sender == owner, "EnergyMarketplace: unauthorized to cancel");

        listing.active = false;
        bool transferred = energyToken.transfer(listing.seller, listing.energyAmount);
        require(transferred, "EnergyMarketplace: token return failed");

        emit ListingCancelled(listingId, listing.seller, listing.energyAmount, block.timestamp);
    }

    /**
     * @notice View helper to check a specific listing's details.
     */
    function getListing(uint256 listingId) external view returns (Listing memory) {
        return listings[listingId];
    }
}
